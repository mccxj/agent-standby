{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "sonnet",
  "availableModels": ["opus", "sonnet", "haiku"],

  "env": {
    "ANTHROPIC_BASE_URL": "{env:ANTHROPIC_BASE_URL}",
    "ANTHROPIC_API_KEY": "{env:API_KEY}",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "{env:AGENT_MODEL_HIGH}",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "{env:AGENT_MODEL_MID}",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{env:AGENT_MODEL_LOW}"
  },

  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(node:*)",
      "Read",
      "Write",
      "Edit",
      "MultiEdit"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  },

  "mcpServers": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp", "--api-key", "{env:CONTEXT7_API_KEY}"],
      "enabled": true
    },
    "context-mode": {
      "type": "local",
      "command": ["npx", "-y", "context-mode"]
    }
  }
}
