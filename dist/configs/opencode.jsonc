{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "autoshare": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "experimental": {
    "batch_tool": true,
    "openTelemetry": false
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "--config", "./.prettierrc", "$FILE"],
      "extensions": [".js", ".ts", ".jsx", ".tsx", ".json", ".jsonc", ".css", ".md", ".yml", ".yaml"]
    }
  },
  "logLevel": "DEBUG",
  "provider": {
    "x-openai": {
      "models": {
        "ollama/minimax-m2.5":{"name":"ollama/minimax-m2.5","modalities":{"input": ["text", "image"], "output": ["text"]}},
        "sensenova/deepseek-v4-flash":{"name":"sensenova/deepseek-v4-flash","modalities":{"input": ["text"], "output": ["text"]}},
        "nvidia/z-ai/glm-5.1":{"name":"nvidia/z-ai/glm-5.1","modalities":{"input": ["text", "image"], "output": ["text"]}}
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:API_KEY}",
        "baseURL": "https://airfly.dpdns.org/v1"
      }
    }
  },
  "plugin": ["oh-my-openagent@latest", "@tarquinen/opencode-dcp@latest", "context-mode"],
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp", "--api-key", "{env:CONTEXT7_API_KEY}"],
      "enabled": true
    },
    "context-mode": {
      "type": "local",
      "command": ["npx", "-y", "context-mode"]
    }
  },
  "lsp": {
    "jdtls": {
      "disabled": false,
      "command": ["jdtls"],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64"
      }
    }
  }
}
