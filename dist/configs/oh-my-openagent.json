{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",

  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "tmux_visualization": false
  },

  "categories": {
    "deep-reasoning": {
      "model": "{env:AGENT_MODEL_HIGH}",
      "temperature": 0.1,
      "reasoningEffort": "xhigh"
    },

    "general-execution": {
      "model": "{env:AGENT_MODEL_MID}",
      "temperature": 0.1,
      "reasoningEffort": "medium"
    },

    "quick-fix": {
      "model": "{env:AGENT_MODEL_LOW}",
      "temperature": 0.1,
      "reasoningEffort": "low"
    }
  },

  "agents": {
    "prometheus": {
      "category": "deep-reasoning",
      "reasoningEffort": "xhigh"
    },
    "metis": {
      "category": "deep-reasoning",
      "reasoningEffort": "xhigh"
    },
    "oracle": {
      "category": "deep-reasoning",
      "reasoningEffort": "xhigh"
    },

    "sisyphus": {
      "category": "general-execution",
      "reasoningEffort": "high"
    },
    "hephaestus": {
      "category": "general-execution",
      "reasoningEffort": "high",
      "upgrade_rules": [
        { "file_count": ">5", "category": "deep-reasoning" },
        { "line_changes": ">200", "category": "deep-reasoning" }
      ]
    },
    "momus": {
      "category": "general-execution",
      "reasoningEffort": "high",
      "upgrade_rules": [
        { "keywords": ["架构评审", "技术方案", "设计文档", "审计"], "category": "deep-reasoning" }
      ]
    },
    "atlas": { "category": "general-execution" },
    "sisyphus-junior": { "category": "general-execution" },

    "explore": { "category": "quick-fix" },
    "librarian": { "category": "quick-fix" },

    "multimodal-looker": { "category": "general-execution" },
    "frontend": { "category": "general-execution" }
  },

  "disabled_categories": [
    "visual-engineering",
    "ultrabrain",
    "artistry",
    "quick",
    "unspecified-low",
    "unspecified-high",
    "writing",
    "deep"
  ]
}
